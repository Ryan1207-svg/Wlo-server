<Project>
  <Target Name="ApplyWloItemUseFixes"
          BeforeTargets="CoreCompile"
          Condition="'$(OS)' == 'Windows_NT' and '$(MSBuildProjectName)' == 'wlo.pserver.core'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Tools\Fix-WloConsumables.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)..&quot;" />
  </Target>
</Project>
